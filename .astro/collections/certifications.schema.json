{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string"
    },
    "organisme": {
      "type": "string"
    },
    "domaine": {
      "type": "string"
    },
    "niveau": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "preuves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "default": "autre",
            "type": "string",
            "enum": [
              "credly",
              "coursera",
              "drive",
              "linkedin",
              "organisme",
              "autre"
            ]
          },
          "url": {
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "credlyUrl": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "badge": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fichier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "ordre": {
      "default": 0,
      "type": "number"
    },
    "projets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "nom",
    "organisme",
    "domaine"
  ]
}