---
import Base from '../layouts/Base.astro';
import { site, contactList, contactForm, contactFormEnabled, cv, cvEnabled } from '../lib/site';

// Initiales pour l'avatar de repli (si pas de photo dans public/avatar.jpg)
const initiales = site.author.split(' ').map((m) => m[0]).slice(0, 2).join('');

const piliers = [
  {
    couleur: 'var(--c-systemes)',
    titre: 'Ingénierie Systèmes',
    texte:
      'Comprendre la machine de bas en haut : mémoire, processus, noyau, réseau. ' +
      'Construire des systèmes robustes et savoir pourquoi ils tiennent.',
  },
  {
    couleur: 'var(--c-business)',
    titre: 'Business Analysis',
    texte:
      'Traduire un besoin métier en spécifications claires : élicitation, modélisation ' +
      'BPMN, BRD, critères d’acceptation. Relier la technique à la décision.',
  },
];
---
<Base
  title={`À propos — ${site.brand}`}
  description="Ingénieur systèmes et business analyst. Parcours, philosophie de travail et contact."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">À propos</p>

      <!-- INTRO -->
      <div class="intro">
        <div class="intro__avatar" aria-hidden="true">{initiales}</div>
        <div class="intro__txt">
          <h1 class="ttl">{site.author}</h1>
          <p class="role mono">
            {site.role} · {site.location}
          </p>
          <p class="lead text-muted">{site.tagline}</p>
        </div>
      </div>

      <!-- BIO — ✏️ à personnaliser -->
      <div class="bio prose">
        <p>
          Je documente une trajectoire d’ingénierie sur deux pistes complémentaires :
          l’<strong>ingénierie des systèmes</strong> et le <strong>business analysis</strong>.
          Mon approche est simple : <em>apprendre en construisant</em>, et faire de chaque
          projet une preuve concrète plutôt qu’une ligne sur un CV.
        </p>
        <p>
          <!-- ✏️ Remplace ce paragraphe par ta vraie présentation (parcours,
               motivations, ce que tu cherches). -->
          De la gestion manuelle de la mémoire en C aux études de cas métier modélisées
          en BPMN, je cherche à relier le fonctionnement profond des machines aux besoins
          réels qu’elles servent. C’est cette double lecture — technique et métier — qui
          guide tout ce que je construis.
        </p>
      </div>

      <!-- DOUBLE PISTE -->
      <div class="piliers">
        {piliers.map((p) => (
          <div class="pilier" style={`--dom:${p.couleur}`}>
            <h2 class="pilier__t">{p.titre}</h2>
            <p class="pilier__x text-muted">{p.texte}</p>
          </div>
        ))}
      </div>

      <!-- CONTACT -->
      <div class="contact" id="contact">
        <h2 class="contact__t">Me contacter</h2>
        <p class="text-muted">Ouvert aux opportunités, collaborations et échanges techniques.</p>

        {cvEnabled && (
          <a class="cv-dl mono" href={cv.path} download={cv.filename}>
            <span aria-hidden="true">↓</span> Télécharger mon CV (PDF)
          </a>
        )}

        {contactFormEnabled && (
          <form class="cform" id="contactForm" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value={contactForm.web3formsKey} />
            <input type="hidden" name="subject" value="Nouveau message — portfolio GnoLab" />
            <input type="hidden" name="from_name" value="Portfolio GnoLab" />
            <!-- Anti-spam (honeypot) : laissé vide par un humain -->
            <input type="checkbox" name="botcheck" class="cform__hp" tabindex="-1" autocomplete="off" />

            <div class="cform__grid">
              <label class="cform__field">
                <span>Nom</span>
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label class="cform__field">
                <span>Email</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
            </div>
            <label class="cform__field">
              <span>Message</span>
              <textarea name="message" rows="5" required></textarea>
            </label>
            <button type="submit" class="cform__btn">Envoyer le message</button>
            <p class="cform__status" id="contactStatus" role="status" aria-live="polite"></p>
          </form>
        )}

        <p class="contact__or text-muted mono">Ou directement :</p>
        <ul class="contact__list">
          {contactList.map((c) => (
            <li>
              <a
                class="contact__link mono"
                href={c.href}
                target={c.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={c.href.startsWith('mailto:') ? undefined : 'noopener'}
              >
                {c.label}
                <span class="contact__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <script>
        // Soumission AJAX du formulaire de contact (Web3Forms) — pas de
        // redirection, message d'état inline. Ne fait rien si le form est absent.
        const form = document.getElementById('contactForm') as HTMLFormElement | null;
        const status = document.getElementById('contactStatus');
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!status) return;
          status.textContent = 'Envoi en cours…';
          status.dataset.state = 'pending';
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });
            const data = await res.json();
            if (res.ok && data.success) {
              status.textContent = 'Merci ! Votre message a bien été envoyé.';
              status.dataset.state = 'ok';
              form.reset();
            } else {
              status.textContent = data.message || "Une erreur est survenue. Réessayez ou écrivez-moi par email.";
              status.dataset.state = 'error';
            }
          } catch {
            status.textContent = "Connexion impossible. Réessayez ou écrivez-moi par email.";
            status.dataset.state = 'error';
          }
        });
      </script>
    </div>
  </section>
</Base>

<style>
  .ttl { font-size: var(--fs-3xl); }
  .role { color: var(--c-accent); margin-top: var(--sp-2); font-size: var(--fs-sm); }
  .lead { margin-top: var(--sp-3); max-width: 60ch; }

  /* Intro : avatar + texte */
  .intro {
    display: flex; align-items: center; gap: var(--sp-6);
    margin-top: var(--sp-3); flex-wrap: wrap;
  }
  .intro__avatar {
    flex: none;
    width: 120px; height: 120px; border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: var(--fw-bold);
    font-size: var(--fs-2xl); color: var(--c-accent);
    background: var(--c-surface-1);
    border: 1px solid var(--c-line);
  }

  .bio { margin-top: var(--sp-8); max-width: 70ch; }

  /* Double piste */
  .piliers {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-5); margin-top: var(--sp-10);
  }
  .pilier {
    background: var(--c-surface-1);
    border: 1px solid var(--c-line);
    border-top: 3px solid var(--dom);
    border-radius: var(--radius-lg);
    padding: var(--sp-5) var(--sp-6);
  }
  .pilier__t { font-size: var(--fs-lg); color: var(--dom); }
  .pilier__x { margin-top: var(--sp-3); font-size: var(--fs-sm); }

  /* Contact */
  .contact { margin-top: var(--sp-10); padding-top: var(--sp-8); border-top: 1px solid var(--c-line); }
  .contact__t { font-size: var(--fs-2xl); }
  .cv-dl {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    margin-top: var(--sp-4); padding: var(--sp-3) var(--sp-5);
    background: var(--c-accent); color: var(--c-bg);
    border-radius: var(--radius); font-weight: var(--fw-medium);
    transition: background var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .cv-dl:hover { background: var(--c-accent-strong); box-shadow: var(--glow-accent); }
  .contact__list { list-style: none; padding: 0; margin-top: var(--sp-5); display: grid; gap: var(--sp-2); max-width: 480px; }
  .contact__link {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-surface-1); border: 1px solid var(--c-line);
    border-radius: var(--radius-lg); color: var(--c-text);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .contact__link:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .contact__arrow { color: var(--c-accent); }
  .contact__or { margin-top: var(--sp-6); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.1em; }

  /* Formulaire de contact */
  .cform { margin-top: var(--sp-6); max-width: 560px; display: grid; gap: var(--sp-4); }
  .cform__hp { position: absolute; left: -9999px; }
  .cform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .cform__field { display: grid; gap: var(--sp-2); }
  .cform__field > span { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--c-text-muted); }
  .cform input,
  .cform textarea {
    width: 100%; padding: var(--sp-3) var(--sp-4);
    background: var(--c-surface-1); color: var(--c-text);
    border: 1px solid var(--c-line); border-radius: var(--radius-md, 8px);
    font: inherit; resize: vertical;
  }
  .cform input:focus,
  .cform textarea:focus { outline: none; border-color: var(--c-accent); }
  .cform__btn {
    justify-self: start;
    padding: var(--sp-3) var(--sp-6);
    background: var(--c-accent); color: var(--c-bg);
    border: none; border-radius: var(--radius-md, 8px);
    font-family: var(--font-display); font-weight: var(--fw-bold); cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .cform__btn:hover { opacity: 0.9; }
  .cform__status { font-size: var(--fs-sm); min-height: 1.2em; margin: 0; }
  .cform__status[data-state='ok'] { color: var(--c-accent); }
  .cform__status[data-state='error'] { color: #ff6b6b; }
  .cform__status[data-state='pending'] { color: var(--c-text-muted); }

  @media (max-width: 520px) {
    .intro__avatar { width: 88px; height: 88px; font-size: var(--fs-xl); }
    .cform__grid { grid-template-columns: 1fr; }
  }
</style>
