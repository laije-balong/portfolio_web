---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/cards/ProjectCard.astro';
import { DOMAINES, DOMAINE_LIST } from '../../lib/taxonomy';

const projets = (await getCollection('projets')).sort((a, b) => {
  const o = a.data.ordre - b.data.ordre;
  return o !== 0 ? o : b.data.dateDebut.valueOf() - a.data.dateDebut.valueOf();
});

// domaines réellement présents (pour ne pas afficher de filtre vide)
const presents = new Set(projets.map((p) => p.data.domaine));
const filtres = DOMAINE_LIST.filter((d) => presents.has(d));
---
<Base title="Projets — GnoLab" description="Catalogue de projets : ingénierie systèmes, data, business analysis, sécurité.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Catalogue</p>
      <h1 class="ttl">Projets</h1>
      <p class="lead text-muted">
        Filtrables par domaine. Du code système aux études de cas Business Analysis.
      </p>

      <div class="filters" role="group" aria-label="Filtrer par domaine">
        <button class="filters__btn is-active" data-filter="all">Tous</button>
        {filtres.map((d) => (
          <button class="filters__btn" data-filter={d} style={`--dom:${DOMAINES[d].color}`}>
            {DOMAINES[d].label}
          </button>
        ))}
      </div>

      <div class="grid" id="grid">
        {projets.map((p) => (
          <div class="grid__item" data-domaine={p.data.domaine}>
            <ProjectCard
              slug={p.id}
              titre={p.data.titre}
              resume={p.data.resume}
              domaine={p.data.domaine}
              statut={p.data.statut}
              type={p.data.type}
              technos={p.data.technos}
              methodes={p.data.methodes}
              nbLivrables={p.data.livrables.length}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filters__btn');
  const items = document.querySelectorAll<HTMLElement>('.grid__item');
  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      btns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const f = btn.dataset.filter;
      items.forEach((it) => {
        const show = f === 'all' || it.dataset.domaine === f;
        it.style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .ttl { font-size: var(--fs-3xl); margin-top: var(--sp-2); }
  .lead { margin-top: var(--sp-3); max-width: 60ch; }
  .filters {
    display: flex; flex-wrap: wrap; gap: var(--sp-2);
    margin: var(--sp-6) 0;
  }
  .filters__btn {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    padding: 0.5em 1em;
    border-radius: var(--radius-pill);
    background: var(--c-surface-1);
    border: 1px solid var(--c-line);
    color: var(--c-text-muted);
    cursor: pointer;
    transition: all var(--dur) var(--ease);
  }
  .filters__btn:hover { color: var(--c-text); border-color: var(--c-line-strong); }
  .filters__btn.is-active {
    color: var(--dom, var(--c-accent));
    border-color: var(--dom, var(--c-accent));
    background: color-mix(in srgb, var(--dom, var(--c-accent)) 12%, transparent);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--sp-5);
  }
</style>
