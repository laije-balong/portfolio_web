---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { preuveLabel, type PreuveSource } from '../lib/taxonomy';

const certs = (await getCollection('certifications')).sort((a, b) => a.data.ordre - b.data.ordre);
// regroupement par domaine
const parDomaine = certs.reduce((acc, c) => {
  (acc[c.data.domaine] ??= []).push(c);
  return acc;
}, {} as Record<string, typeof certs>);
const fmtAnnee = (d?: Date) => (d ? new Intl.DateTimeFormat('fr-FR', { year: 'numeric' }).format(d) : null);

/* Liste unifiée des liens de vérification d'une certif :
   preuves (nouveau) + credlyUrl (ancien) + fichier joint. */
type Lien = { url: string; texte: string };
const liensVerif = (c: (typeof certs)[number]): Lien[] => {
  const liens: Lien[] = c.data.preuves.map((p) => ({
    url: p.url,
    texte: p.label || preuveLabel(p.source as PreuveSource),
  }));
  if (c.data.credlyUrl) liens.push({ url: c.data.credlyUrl, texte: 'Vérifier sur Credly' });
  if (c.data.fichier) liens.push({ url: c.data.fichier, texte: 'Voir le certificat' });
  return liens;
};
---
<Base title="Certifications — GnoLab" description="14 certifications professionnelles : data, systèmes, sécurité, gestion de projet.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Preuves</p>
      <h1 class="ttl">Certifications</h1>
      <p class="lead text-muted">Vérifiables auprès des organismes émetteurs. Chacune adossée à des projets concrets.</p>

      {Object.entries(parDomaine).map(([domaine, list]) => (
        <div class="cert-group">
          <h2 class="cert-group__title mono">{domaine}</h2>
          <div class="grid">
            {list.map((c) => (
              <div class="cert reveal">
                {c.data.badge && (
                  <img class="cert__badge" src={c.data.badge} alt={`Badge ${c.data.nom}`} loading="lazy" width="64" height="64" />
                )}
                <h3 class="cert__nom">{c.data.nom}</h3>
                <p class="cert__org mono">
                  {c.data.organisme}{c.data.niveau ? ` · ${c.data.niveau}` : ''}
                  {fmtAnnee(c.data.date) ? ` · ${fmtAnnee(c.data.date)}` : ''}
                </p>
                {liensVerif(c).length > 0 && (
                  <div class="cert__links">
                    {liensVerif(c).map((l) => (
                      <a href={l.url} class="cert__link mono" target="_blank" rel="noopener">
                        {l.texte} →
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .ttl { font-size: var(--fs-3xl); margin-top: var(--sp-2); }
  .lead { margin-top: var(--sp-3); margin-bottom: var(--sp-8); }
  .cert-group { margin-top: var(--sp-8); }
  .cert-group__title {
    font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--c-accent); margin-bottom: var(--sp-4);
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--sp-4); }
  .cert {
    padding: var(--sp-5);
    background: var(--c-surface-1);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
  }
  .cert__badge { width: 64px; height: 64px; object-fit: contain; margin-bottom: var(--sp-3); }
  .cert__nom { font-size: var(--fs-md); color: var(--c-text); }
  .cert__org { font-size: var(--fs-sm); color: var(--c-text-muted); margin-top: var(--sp-1); }
  .cert__links { display: flex; flex-direction: column; gap: var(--sp-1); margin-top: var(--sp-3); }
  .cert__link { font-size: var(--fs-sm); color: var(--c-accent); }
  .cert__link:hover { text-decoration: underline; }
</style>
