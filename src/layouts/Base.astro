---
// Polices self-hosted (sous-ensemble latin, graisses réellement utilisées) :
// Vite les bundle/hash en local → plus de requête bloquante vers Google Fonts,
// ni de connexion tierce (fonts.googleapis.com / fonts.gstatic.com).
import '@fontsource/syne/latin-700.css';
import '@fontsource/syne/latin-800.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
// URLs hashées des 2 woff2 critiques (préchargés dans le <head>).
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2';
import syne800 from '@fontsource/syne/files/syne-latin-800-normal.woff2';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/particles.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site, contactList, analytics, analyticsEnabled, verification } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'GnoLab Ingénieur Systèmes & Business Analyst',
  description = 'Portfolio de BALONG Laije Belthassar : ingénierie systèmes, data, business analysis. Projets, parcours et publications techniques depuis Brazzaville.',
  ogImage,
} = Astro.props;

const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base).toString();
// Image OG générée par page (voir src/pages/og/[...slug].png.ts) ; dérivée du
// chemin courant, sauf si un `ogImage` explicite est fourni en prop.
const ogSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'index';
const ogImageUrl = new URL(ogImage ?? `/og/${ogSlug}.png`, base).toString();

// Données structurées schema.org/Person — uniquement sur l'accueil (page
// « identité »). Aide Google et les IA à identifier l'entité « BALONG Laije
// Belthassar » et à relier le site à ses profils (sameAs). Les liens de contact
// (LinkedIn, GitHub, Credly) viennent de lib/site.ts.
const isHome = Astro.url.pathname === '/';
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  jobTitle: site.role,
  url: site.url,
  image: new URL('/og/index.png', base).toString(),
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  sameAs: contactList
    .filter((c) => c.href.startsWith('http'))
    .map((c) => c.href),
};
---
<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Thème : applique le choix (localStorage) ou la préférence système AVANT
         le premier rendu, pour éviter tout flash de couleur (FOUC). -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored
            || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) { /* localStorage indisponible → on garde le défaut dark */ }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    <meta name="theme-color" content="#020a14" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Autodécouverte du flux RSS du blog -->
    <link rel="alternate" type="application/rss+xml" title="GnoLab — Blog" href="/rss.xml" />
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    )}
    <!-- Analytics Umami : sans cookie, chargé en defer (non bloquant).
         is:inline → Astro n'essaie pas de le bundler (c'est un tag tiers). -->
    {analyticsEnabled && (
      <script is:inline defer src={analytics.src} data-website-id={analytics.websiteId}></script>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GnoLab" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Polices self-hosted (importées plus haut, voir frontmatter).
         Préchargement des 2 graisses critiques au rendu initial (corps + titres)
         pour réduire le décalage de texte (CLS) au premier affichage. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={dmSans400}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={syne800}
      crossorigin
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Révélation au scroll : progressive enhancement -->
    <script>
      const els = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--c-accent);
        color: var(--c-bg);
        padding: var(--sp-2) var(--sp-4);
        z-index: var(--z-overlay);
      }
      .skip-link:focus { left: var(--sp-4); }
    </style>
  </body>
</html>
