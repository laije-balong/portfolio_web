---
// Polices self-hosted (sous-ensemble latin, graisses réellement utilisées) :
// Vite les bundle/hash en local → plus de requête bloquante vers Google Fonts,
// ni de connexion tierce (fonts.googleapis.com / fonts.gstatic.com).
import '@fontsource/syne/latin-700.css';
import '@fontsource/syne/latin-800.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
// URLs hashées des 2 woff2 critiques (préchargés dans le <head>).
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2';
import syne800 from '@fontsource/syne/files/syne-latin-800-normal.woff2';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/particles.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'GnoLab — Ingénieur Systèmes & Business Analyst',
  description = 'Portfolio de BALONG Laije Belthassar : ingénierie systèmes, data, business analysis. Projets, parcours et publications techniques depuis Brazzaville.',
  ogImage,
} = Astro.props;

const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base).toString();
// Image OG générée par page (voir src/pages/og/[...slug].png.ts) ; dérivée du
// chemin courant, sauf si un `ogImage` explicite est fourni en prop.
const ogSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'index';
const ogImageUrl = new URL(ogImage ?? `/og/${ogSlug}.png`, base).toString();
---
<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020a14" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GnoLab" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Polices self-hosted (importées plus haut, voir frontmatter).
         Préchargement des 2 graisses critiques au rendu initial (corps + titres)
         pour réduire le décalage de texte (CLS) au premier affichage. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={dmSans400}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={syne800}
      crossorigin
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Révélation au scroll : progressive enhancement -->
    <script>
      const els = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--c-accent);
        color: var(--c-bg);
        padding: var(--sp-2) var(--sp-4);
        z-index: var(--z-overlay);
      }
      .skip-link:focus { left: var(--sp-4); }
    </style>
  </body>
</html>
