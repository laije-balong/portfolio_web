---
const nav = [
  { href: '/projets',        label: 'Projets' },
  { href: '/parcours',       label: 'Parcours' },
  { href: '/blog',           label: 'Blog' },
  { href: '/certifications', label: 'Certifications' },
  { href: '/uses',           label: 'Uses' },
  { href: '/a-propos',       label: 'À propos' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hdr">
  <div class="container hdr__inner">
    <a href="/" class="hdr__logo" aria-label="GnoLab — accueil">
      <span class="hdr__mark">▚</span>
      <span class="hdr__name">GnoLab</span>
    </a>

    <nav class="hdr__nav" aria-label="Navigation principale">
      {nav.map((item) => (
        <a href={item.href} class:list={['hdr__link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <button class="hdr__theme" id="themeToggle" type="button"
            aria-label="Changer de thème (clair / sombre)" title="Changer de thème">
      <!-- Lune (visible en thème sombre → bascule vers clair) -->
      <svg class="hdr__icon hdr__icon--moon" width="18" height="18" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <!-- Soleil (visible en thème clair → bascule vers sombre) -->
      <svg class="hdr__icon hdr__icon--sun" width="18" height="18" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
      </svg>
    </button>

    <button class="hdr__burger" aria-label="Menu" aria-expanded="false" id="burger">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const hdr = document.querySelector('.hdr');
  burger?.addEventListener('click', () => {
    const open = hdr?.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
  });

  // Bascule de thème (le thème initial est appliqué par le script inline du <head>).
  const themeBtn = document.getElementById('themeToggle');
  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (_) { /* ignore */ }
  });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--c-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-line);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .hdr__logo { display: flex; align-items: center; gap: var(--sp-2); }
  .hdr__mark { color: var(--c-accent); font-size: var(--fs-lg); }
  .hdr__name {
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: var(--fs-md);
    letter-spacing: -0.02em;
  }
  .hdr__nav { display: flex; gap: var(--sp-5); }
  .hdr__link {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    padding: var(--sp-1) 0;
    border-bottom: 1px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .hdr__link:hover { color: var(--c-text); }
  .hdr__link.is-active { color: var(--c-accent); border-color: var(--c-accent); }

  /* Bascule de thème */
  .hdr__theme {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    margin-left: var(--sp-4);
    background: none;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    color: var(--c-text-muted);
    cursor: pointer;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .hdr__theme:hover { color: var(--c-accent); border-color: var(--c-accent); }
  /* Affiche l'icône pertinente selon le thème courant */
  .hdr__icon--sun { display: none; }
  :root[data-theme="light"] .hdr__icon--moon { display: none; }
  :root[data-theme="light"] .hdr__icon--sun { display: inline; }

  .hdr__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--sp-2);
  }
  .hdr__burger span {
    width: 22px; height: 2px;
    background: var(--c-text);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  @media (max-width: 820px) {
    .hdr__burger { display: flex; }
    .hdr__nav {
      position: absolute;
      top: 64px; left: 0; right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--c-surface-1);
      border-bottom: 1px solid var(--c-line);
      padding: var(--sp-3) var(--sp-5);
      transform: translateY(-12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .hdr.is-open .hdr__nav { opacity: 1; transform: none; pointer-events: auto; }
    .hdr__link { padding: var(--sp-3) 0; border-bottom: 1px solid var(--c-line); }
  }
</style>
