---
import Badge from '../ui/Badge.astro';
import Tag from '../ui/Tag.astro';
import { DOMAINES, STATUTS, type Domaine, type Statut } from '../../lib/taxonomy';

interface Props {
  slug: string;
  titre: string;
  resume: string;
  domaine: Domaine;
  statut: Statut;
  type: string;
  technos?: string[];
  methodes?: string[];
  nbLivrables?: number;
  /** Lien du dépôt (livrable de type github) — affiché en bas de carte si présent. */
  githubUrl?: string;
}
const {
  slug, titre, resume, domaine, statut, type,
  technos = [], methodes = [], nbLivrables = 0, githubUrl,
} = Astro.props;
const dom = DOMAINES[domaine];
const st = STATUTS[statut];
const chips = [...technos, ...methodes].slice(0, 4);
const typeLabel: Record<string, string> = {
  repo: 'Projet', 'etude-de-cas': 'Étude de cas', dashboard: 'Dashboard',
  document: 'Document', analyse: 'Analyse',
};
---
<!-- La carte n'est plus un <a> global (interdit d'imbriquer un lien GitHub
     dedans) : le titre porte un lien « étiré » via ::after qui couvre toute
     la carte, et le lien GitHub passe au-dessus grâce à son z-index. -->
<div class="pcard reveal" style={`--dom:${dom.color}`}>
  <div class="pcard__top">
    <Badge label={dom.label} color={dom.color} />
    <span class="pcard__type">{typeLabel[type] ?? type}</span>
  </div>

  <h3 class="pcard__title">
    <a class="pcard__link" href={`/projets/${slug}`}>{titre}</a>
  </h3>
  <p class="pcard__resume">{resume}</p>

  {chips.length > 0 && (
    <div class="pcard__chips">
      {chips.map((c) => <Tag label={c} />)}
    </div>
  )}

  <div class="pcard__foot">
    <span class="pcard__status" style={`--st:${st.color}`}>
      <span class="pcard__statusdot"></span>{st.label}
    </span>
    {nbLivrables > 0 && (
      <span class="pcard__livr mono">{nbLivrables} livrable{nbLivrables > 1 ? 's' : ''}</span>
    )}
    {githubUrl && (
      <a
        class="pcard__gh mono"
        href={githubUrl}
        target="_blank"
        rel="noopener"
        aria-label={`Code source de ${titre} sur GitHub`}
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        Code
      </a>
    )}
  </div>
</div>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background: var(--c-surface-1);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    border-top: 2px solid var(--dom);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease);
    height: 100%;
  }
  .pcard:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--dom) 45%, var(--c-line));
    box-shadow: var(--shadow);
  }
  .pcard:focus-within {
    border-color: color-mix(in srgb, var(--dom) 45%, var(--c-line));
  }
  .pcard__top { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
  .pcard__type {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pcard__title { font-size: var(--fs-lg); color: var(--c-text); }
  .pcard__link { color: inherit; text-decoration: none; }
  /* Lien « étiré » : couvre toute la carte tout en laissant le lien GitHub cliquable */
  .pcard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }
  .pcard__resume {
    color: var(--c-text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-base);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pcard__chips { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .pcard__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-top: auto;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--c-line);
  }
  .pcard__status {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--st);
  }
  .pcard__statusdot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--st);
  }
  .pcard__livr { font-size: var(--fs-xs); color: var(--c-text-faint); }
  /* Lien GitHub : au-dessus de la zone étirée, poussé à droite */
  .pcard__gh {
    position: relative;
    z-index: 1;
    display: inline-flex; align-items: center; gap: 4px;
    margin-left: auto;
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
    transition: color var(--dur) var(--ease);
  }
  .pcard__gh:hover { color: var(--c-accent); }
</style>
