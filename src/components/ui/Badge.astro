---
/**
 * Badge — pastille colorée pour domaine ou statut.
 * Usage : <Badge color="var(--c-business)" label="Business Analysis" />
 */
interface Props {
  label: string;
  color?: string;
  dot?: boolean;
}
const { label, color = 'var(--c-accent)', dot = true } = Astro.props;
---
<span class="badge" style={`--badge-c:${color}`}>
  {dot && <span class="badge__dot" aria-hidden="true"></span>}
  {label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    padding: 0.3em 0.7em;
    border-radius: var(--radius-pill);
    color: var(--badge-c);
    background: color-mix(in srgb, var(--badge-c) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--badge-c) 35%, transparent);
    white-space: nowrap;
  }
  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--badge-c);
    box-shadow: 0 0 8px var(--badge-c);
  }
</style>
