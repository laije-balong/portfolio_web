---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tag from '../../components/ui/Tag.astro';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((a) => a.data.publie);
  return articles.map((a) => ({ params: { slug: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const dateStr = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d.date);
---
<Base title={`${d.titre} — GnoLab`} description={d.resume}>
  <article class="section">
    <div class="container art">
      <a href="/blog" class="back mono">← Tous les articles</a>
      <header class="art__head">
        <p class="art__meta mono">{dateStr} · {d.tempsLecture} min de lecture</p>
        <h1 class="art__title">{d.titre}</h1>
        <p class="art__resume">{d.resume}</p>
        {d.tags.length > 0 && <div class="art__tags">{d.tags.map((t) => <Tag label={t} />)}</div>}
      </header>
      <div class="prose art__body">
        <Content />
      </div>
      {d.projetLie && (
        <a href={`/projets/${d.projetLie}`} class="art__related mono">
          → Voir le projet associé
        </a>
      )}
    </div>
  </article>
</Base>

<style>
  .art { max-width: var(--container-prose); }
  .back { color: var(--c-text-muted); font-size: var(--fs-sm); }
  .back:hover { color: var(--c-accent); }
  .art__head { margin: var(--sp-5) 0 var(--sp-8); }
  .art__meta { color: var(--c-accent); font-size: var(--fs-sm); }
  .art__title { font-size: var(--fs-3xl); margin-top: var(--sp-3); }
  .art__resume { margin-top: var(--sp-4); color: var(--c-text-muted); font-size: var(--fs-md); }
  .art__tags { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-4); }
  .art__related {
    display: inline-block;
    margin-top: var(--sp-8);
    color: var(--c-accent);
    border: 1px solid var(--c-accent-line);
    padding: var(--sp-3) var(--sp-5);
    border-radius: var(--radius);
  }
  .art__related:hover { background: var(--c-accent-soft); }
</style>
