---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PISTES, type Piste } from '../lib/taxonomy';

// Timeline éditable : jalons de la collection « parcours » (src/content/jalons/),
// triés chronologiquement (du plus ancien au plus récent). Géré via /keystatic.
const jalons = (await getCollection('jalons')).sort((a, b) => {
  const d = a.data.date.valueOf() - b.data.date.valueOf();
  return d !== 0 ? d : a.data.ordre - b.data.ordre;
});
const fmt = (d: Date) => new Intl.DateTimeFormat('fr-FR', { month: 'short', year: 'numeric' }).format(d);
---
<Base title="Parcours — GnoLab" description="Trajectoire d'ingénierie systèmes et de business analysis, jalon par jalon.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Trajectoire</p>
      <h1 class="ttl">Mon parcours</h1>
      <p class="lead text-muted">
        De la mémoire manuelle en C aux études de cas Business Analysis — une progression
        documentée, sur une double piste : ingénierie systèmes et business analysis.
      </p>

      {jalons.length === 0 ? (
        <p class="empty text-muted mono">Aucun jalon pour l'instant. Ajoute-en depuis <a href="/keystatic">/keystatic</a> → « Parcours (jalons) ».</p>
      ) : (
        <ol class="timeline">
          {jalons.map((j) => {
            const piste = PISTES[j.data.piste as Piste] ?? PISTES.transverse;
            return (
              <li class="timeline__item reveal" style={`--dom:${piste.color}`}>
                <span class="timeline__date mono">{fmt(j.data.date)}</span>
                <div class="timeline__card">
                  <span class="timeline__dom mono">
                    {piste.label}{j.data.phase ? ` · ${j.data.phase}` : ''}
                    {j.data.encours && <span class="timeline__live"> · en cours</span>}
                  </span>
                  <h2 class="timeline__title">{j.data.titre}</h2>
                  <p class="timeline__resume">{j.data.resume}</p>
                </div>
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>
</Base>

<style>
  .ttl { font-size: var(--fs-3xl); margin-top: var(--sp-2); }
  .lead { margin-top: var(--sp-3); margin-bottom: var(--sp-8); max-width: 65ch; }
  .timeline { list-style: none; padding: 0; position: relative; }
  .timeline::before {
    content: ''; position: absolute; left: 110px; top: 0; bottom: 0;
    width: 1px; background: var(--c-line);
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--sp-5);
    padding-bottom: var(--sp-6);
    position: relative;
  }
  .timeline__date { text-align: right; color: var(--c-text-faint); font-size: var(--fs-xs); padding-top: var(--sp-4); }
  .timeline__card {
    background: var(--c-surface-1);
    border: 1px solid var(--c-line);
    border-left: 3px solid var(--dom);
    border-radius: var(--radius-lg);
    padding: var(--sp-4) var(--sp-5);
    position: relative;
  }
  .timeline__card::before {
    content: ''; position: absolute; left: -27px; top: 22px;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--dom); box-shadow: 0 0 10px var(--dom);
  }
  .timeline__dom { font-size: var(--fs-xs); color: var(--dom); }
  .timeline__live { color: var(--c-status-progress, var(--c-accent)); }
  .empty { margin-top: var(--sp-6); }
  .empty a { color: var(--c-accent); }
  .timeline__title { display: block; font-family: var(--font-display); font-weight: var(--fw-bold); font-size: var(--fs-md); color: var(--c-text); margin-top: var(--sp-1); }
  .timeline__title:hover { color: var(--c-accent); }
  .timeline__resume { color: var(--c-text-muted); font-size: var(--fs-sm); margin-top: var(--sp-2); }

  @media (max-width: 640px) {
    .timeline::before { left: 5px; }
    .timeline__item { grid-template-columns: 1fr; gap: var(--sp-2); padding-left: var(--sp-5); }
    .timeline__date { text-align: left; padding-top: 0; }
    .timeline__card::before { left: -19px; }
  }
</style>
