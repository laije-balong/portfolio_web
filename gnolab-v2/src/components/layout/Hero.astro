---
import Button from '../ui/Button.astro';
import Stat from '../ui/Stat.astro';

interface Props {
  nbProjets: number;
  nbTermines: number;
  nbArticles: number;
}
const { nbProjets, nbTermines, nbArticles } = Astro.props;
---
<section class="hero" aria-label="Introduction">
  <!-- Système de particules (data-viz) — porté de l'ancien site -->
  <svg id="particle-canvas" class="hero-canvas" aria-hidden="true"
       preserveAspectRatio="xMidYMid slice"></svg>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="eyebrow">Ingénieur Systèmes · Business Analyst · Brazzaville</p>
    <h1 class="hero__title">
      Construire des systèmes qui fonctionnent.<br />
      <span class="hero__accent">Comprendre le besoin qui les justifie.</span>
    </h1>
    <p class="hero__lead">
      Je documente une trajectoire d'ingénierie : du transistor au scheduler,
      de l'adresse virtuelle au cache L1 — et du besoin métier au business case.
      Chaque projet est une preuve.
    </p>
    <div class="hero__cta">
      <Button href="/projets">Voir les projets</Button>
      <Button href="/parcours" variant="ghost">Mon parcours →</Button>
    </div>
    <div class="hero__stats">
      <Stat value={`${nbProjets}`} label="Projets" />
      <Stat value={`${nbTermines}`} label="Terminés" />
      <Stat value={`${nbArticles}`} label="Articles" />
      <Stat value="14" label="Certifications" />
    </div>
  </div>
</section>

<script>
  import { ParticleSystem } from '../../scripts/particles/ParticleSystem.js';

  const svg = document.getElementById('particle-canvas');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (svg && !reduce) {
    // @ts-ignore — module JS vanilla sans types
    const ps = new ParticleSystem(svg);
    ps.init();
    // Nettoyage propre lors d'une navigation (View Transitions Astro)
    document.addEventListener('astro:before-swap', () => ps.destroy(), { once: true });
    window.addEventListener('beforeunload', () => ps.destroy(), { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  /* Voile : lisibilité du texte par-dessus les particules */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(70% 60% at 50% 40%, transparent, var(--c-bg) 92%),
      linear-gradient(to right, var(--c-bg) 0%, transparent 55%);
  }
  .hero__inner { position: relative; z-index: 2; max-width: 860px; }

  .hero__title { font-size: clamp(2rem, 5vw, var(--fs-4xl)); margin-top: var(--sp-4); }
  .hero__accent { color: var(--c-accent); }
  .hero__lead {
    margin-top: var(--sp-5);
    font-size: var(--fs-md);
    color: var(--c-text-muted);
    max-width: 58ch;
  }
  .hero__cta { display: flex; gap: var(--sp-3); margin-top: var(--sp-6); flex-wrap: wrap; }
  .hero__stats {
    display: flex; gap: var(--sp-8); margin-top: var(--sp-10); flex-wrap: wrap;
    padding-top: var(--sp-6); border-top: 1px solid var(--c-line);
  }
</style>
