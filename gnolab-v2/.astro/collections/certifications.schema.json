{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string"
    },
    "organisme": {
      "type": "string"
    },
    "domaine": {
      "type": "string"
    },
    "credlyUrl": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "ordre": {
      "default": 0,
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "nom",
    "organisme",
    "domaine"
  ]
}