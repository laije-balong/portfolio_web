{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titre": {
      "type": "string"
    },
    "resume": {
      "type": "string"
    },
    "domaine": {
      "type": "string",
      "enum": [
        "Systèmes",
        "Data-ML",
        "Business-Analysis",
        "Sécurité",
        "Architecture",
        "Maths"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "repo",
        "etude-de-cas",
        "dashboard",
        "document",
        "analyse"
      ]
    },
    "track": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E",
                "F"
              ]
            },
            {
              "type": "string",
              "const": ""
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "niveau": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "statut": {
      "type": "string",
      "enum": [
        "planifié",
        "en-cours",
        "terminé"
      ]
    },
    "phase": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "dateDebut": {
      "type": "string",
      "format": "date-time"
    },
    "dateFin": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "technos": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "methodes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "livrables": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "github",
              "pdf",
              "bpmn",
              "powerbi",
              "slides",
              "demo",
              "document"
            ]
          },
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url",
          "label"
        ]
      }
    },
    "cover": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "ordre": {
      "default": 0,
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "titre",
    "resume",
    "domaine",
    "type",
    "statut",
    "dateDebut"
  ]
}