{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titre": {
      "type": "string"
    },
    "resume": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tempsLecture": {
      "default": 5,
      "type": "number"
    },
    "projetLie": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "publie": {
      "default": true,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "titre",
    "resume",
    "date"
  ]
}